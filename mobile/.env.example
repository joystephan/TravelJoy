# TravelJoy Mobile App Environment Variables
# Copy this file to .env and fill in your actual values

# ================================
# Backend API Configuration
# ================================
# Local development (iOS Simulator)
API_URL=http://localhost:3000

# Local development (Android Emulator)
# API_URL=http://10.0.2.2:3000

# Local development (Physical device on same network)
# Replace with your computer's local IP address
# API_URL=http://192.168.1.XXX:3000

# Production
# API_URL=https://api.traveljoy.com

# ================================
# App Configuration
# ================================
# App environment: development, staging, production
APP_ENV=development

# Enable debug logging
DEBUG_MODE=true

# ================================
# Feature Flags (Optional)
# ================================
# ENABLE_ANALYTICS=false
# ENABLE_CRASH_REPORTING=false

# ================================
# Expo Configuration (Optional)
# ================================
# These are typically managed by Expo but can be overridden
# EXPO_PUBLIC_API_URL=http://localhost:3000
