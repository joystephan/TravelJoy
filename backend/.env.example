# TravelJoy Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=3000

# ================================
# Database Configuration
# ================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://user:password@localhost:5432/traveljoy?schema=public

# ================================
# Redis Configuration
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Alternative: Full Redis URL (if using cloud Redis)
# REDIS_URL=redis://localhost:6379

# ================================
# Authentication
# ================================
# Secret key for JWT token signing (use a strong random string in production)
JWT_SECRET=your-secret-key-change-in-production
# JWT token expiration time (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# ================================
# Stripe Payment Configuration
# ================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Price IDs from your Stripe products
STRIPE_BASIC_PRICE_ID=price_basic_plan_id
STRIPE_PREMIUM_PRICE_ID=price_premium_plan_id

# ================================
# External APIs
# ================================
# OpenWeatherMap API Key (required for weather data)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# ================================
# AI Provider Configuration
# ================================
# Choose AI provider: 'ollama' (local) or 'huggingface' (cloud)
AI_PROVIDER=ollama

# Ollama Configuration (for local LLM)
# Install from: https://ollama.ai
OLLAMA_URL=http://localhost:11434
# Available models: llama2, llama3, mistral, codellama, etc.
AI_MODEL=llama2

# HuggingFace Configuration (alternative to Ollama)
# Get API key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your_huggingface_api_key
# AI_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# ================================
# Optional: Monitoring & Logging
# ================================
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn

# ================================
# Docker-specific (when running in containers)
# ================================
# When running in Docker, use service names instead of localhost:
# DATABASE_URL=postgresql://user:password@postgres:5432/traveljoy?schema=public
# REDIS_HOST=redis
# OLLAMA_URL=http://host.docker.internal:11434
